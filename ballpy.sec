import pygame
from rsoccer_gym.Render.utils import COLORS


class Ball:
    radius = 0.0215

    def __init__(self, x, y, scale) -> None:
        self.x = x
        self.y = y
        self.radius *= scale
        self.scale = scale

    def update(self, x, y):
        self.x = x
        self.y = y

    def draw(self, screen):
        pygame.draw.circle(screen, COLORS["ORANGE"], (self.x, self.y), self.radius)
        pygame.draw.circle(screen, COLORS["BLACK"], (self.x, self.y), self.radius, 1)
        # Draw an orange cross for better visibility
        cross_len = self.radius * 3.5
        center = (int(self.x), int(self.y))
        pygame.draw.line(
            screen, COLORS["ORANGE"],
            (center[0] - 1/2 * cross_len, center[1]- 1/2 * cross_len),
            (center[0] + 1/2 * cross_len, center[1]+ 1/2 * cross_len),
            1
        )
        pygame.draw.line(
            screen, COLORS["ORANGE"],
            (center[0] + 1/2 * cross_len, center[1] - 1/2 * cross_len),
            (center[0] - 1/2 * cross_len, center[1] + 1/2 * cross_len),
            1
        )
